{
  "name": "courier",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "dev:auth": "ts-node-dev --respawn --transpile-only src/auth/main.auth.ts",
    "dev:user": "ts-node-dev --respawn --transpile-only src/operations/main.operations.ts",
    "dev:gateway": "ts-node-dev --respawn --transpile-only src/gateway/main.gateway.ts",
    "dev:fulfillment": "ts-node-dev --respawn --transpile-only src/fulfillment/main.fulfillment.ts",
    "dev": "concurrently -n gateway,auth,user,fulfillment -c green,cyan,magenta \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:fulfillment\"",
    "start:auth": "node dist/auth/main.auth.js",
    "start:user": "node dist/operations/main.operations.js",
    "start:gateway": "node dist/gateway/main.gateway.js",
    "start:fulfillment": "node dist/fulfillment/main.fulfillment.js",
    "start:auth:dev": "nest start --watch --entryFile auth/main.auth",
    "start:user:dev": "nest start --watch --entryFile operations/main.operations",
    "start:gateway:dev": "nest start --watch --entryFile gateway/main.gateway",
    "start:fulfillment:dev": "nest start --watch --entryFile fulfillment/main.fulfillment",
    "start:prod": "concurrently -n gateway,auth,user,fulfillment -c green,cyan,magenta,yellow \"npm run start:gateway\" \"npm run start:auth\" \"npm run start:user\" \"npm run start:fulfillment\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@mapbox/polyline": "^1.2.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/websockets": "^11.1.6",
    "@prisma/client": "^6.15.0",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.8.0",
    "concurrently": "^9.2.1",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nest-winston": "^1.10.2",
    "nestjs-pino": "^2.5.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "redis": "^5.8.3",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^11.1.6",
    "@types/cron": "^2.4.3",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.0.0",
    "prisma": "^6.15.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
