generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  password           String
  phone              String?            @unique
  branchId           String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  emailVerified      Boolean            @default(false)
  roleId             String?
  isStaff            Boolean            @default(false)
  isSuperAdmin       Boolean            @default(false)
  logs               AuditLog[]
  bookmarks          Bookmark[]
  managedBranch      Branch?            @relation("BranchManager")
  emialVarifiCation  EmailVerification?
  mfa                Mfa?
  notifications      Notification[]
  orders             Order[]            @relation("CustomerOrders")
  //assignedOrders     Order[]            @relation("DriverOrders")
  validatedOrders    Order[]            @relation("ValidateOrders")
  passwordReset      PasswordReset[]
  refreshTokens      RefreshToken[]
  branch             Branch?            @relation(fields: [branchId], references: [id])
  role               Role?              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  //vehicles          Vehicle[]
  customerType       CustomerType?
  customerCategoryId String?
  customerCategory   CustomerCategory?  @relation(fields: [customerCategoryId], references: [id])
  approvals          ParcelApproval[]   @relation("StaffApprovals")

  addresses              Address[]
  preferences            UserPreferences?
  createdBatches         BatchDispatch[]  @relation("CreatedBatches")
  driverBatches          BatchDispatch[]  @relation("BatchDispatchDriver")
  officerBatches         BatchDispatch[]  @relation("BatchDispatchOfficer")
  handOverBatchesOfficer BatchHandover[]  @relation("HandoverBatchesOfficer")

pickupOrders  Order[]  @relation("PickupDriverOrders")
deliveryOrders Order[] @relation("DeliveryDriverOrders")

  corporateInfo CorporateInfo?
  driver        Driver?

  @@index([isStaff])
  @@index([branchId])
  @@index([roleId])
  @@index([customerCategoryId])
}

model CorporateInfo {
  userId         String  @id
  companyName    String
  taxId          String?
  registrationNo String?
  contactPerson  String?
  contactPhone   String?
  contactEmail   String?
  industryType   String?
  website        String?
  address        String?
  notes          String?

  user User @relation(fields: [userId], references: [id])
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

model Address {
  id          String         @id @default(cuid())
  label       String // e.g. "Home", "Office"
  addressLine String
  city        String
  state       String?
  country     String
  postalCode  String?
  lat         String?
  long        String?
  purpose     AddressPurpose
  userId      String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
    branchId    String?        @unique 

  user           User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickupOrders   Order[] @relation("PickupAddress")
  deliveryOrders Order[] @relation("DeliveryAddress")
  branch         Branch?  @relation("BranchAddress", fields: [branchId], references: [id], onDelete: Cascade)

  originBatches      BatchDispatch[] @relation("BatchOrigin")
  destinationBatches BatchDispatch[] @relation("BatchDestination")

  @@index([lat, long], name: "idx_address_coords")
  @@index([userId])
  @@index([purpose])
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  defaultPayment       String?
  defaultDropoffBranch String?
  deliveryNotes        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id              String           @id @default(cuid())
  resource        String // e.g., "User", "Order", "Branch"
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([resource]) // one row per resource
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String

  // Actions assigned to this role for this permission/resource
  createAction Boolean @default(false)
  readAction   Boolean @default(false)
  updateAction Boolean @default(false)
  deleteAction Boolean @default(false)

  @@unique([roleId, permissionId]) // prevent duplicates
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String
  managerId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  manager   User?    @relation("BranchManager", fields: [managerId], references: [id])
  orders    Order[]
  staff     User[]
  address   Address? @relation("BranchAddress")
}

model Vehicle {
  id          String        @id @default(cuid())
  plateNumber String        @unique
  type        String
  status      VehicleStatus
  model       String?
  driverId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  fleetLogs   FleetLog[]

  // driver      User?         @relation(fields: [driverId], references: [id])
  batchDispatches BatchDispatch[] @relation("BatchDispatchVehicle")
  driver          Driver?         @relation("VehicleDriver", fields: [driverId], references: [id], map: "Vehicle_driver_fkey")

  @@index([status])
  @@index([driverId])
}

model FleetLog {
  id          String   @id @default(cuid())
  vehicleId   String
  maintenance String
  cost        Float?
  date        DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
}

model Order {
  id              String          @id @default(cuid())
  trackingCode    String          @unique
  customerId      String
  branchId        String?
  pickupDriverId  String?        
  deliveryDriverId String? 
  status          OrderStatus     @default(PENDING)
  serviceType     ServiceType
  fulfillmentType FulfillmentType @default(PICKUP)

  // 📦 Parcel details
  weight        Float
  length        Float?
  width         Float?
  height        Float?
  category      ParcelCategory?
  isFragile     Boolean         @default(false)
  shipmentType  ShipmentType?
  shippingScope ShippingScope?
  isUnusual     Boolean         @default(false)
  unusualReason String?

  // Delivery info
  pickupAddressId   String? // lan+*+long+*+NAME
  pickupDate        DateTime?
  deliveryAddressId String? // lan+*+long+*+NAME
  deliveryDate      DateTime?
  pickupConfirmed   Boolean   @default(false)
  dropoffConfirmed  Boolean   @default(false)
  actualPickupDate  DateTime?
  actualDropoffDate DateTime?
  notes             String?
  cost              Float?
  distance          Float?
  validatedBy       String?
  validatedAt       DateTime?
  validatedNotes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  batchId   String?

  // Tariff & Pricing
  tariffId          String?
  tariff            Tariff? @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  finalPrice        Float? // after all surcharges, fees, discounts, margins
  currency          String? @default("ETB")
  optimizationJobId String?

  // Relations
  branch          Branch?          @relation(fields: [branchId], references: [id])
  customer        User             @relation("CustomerOrders", fields: [customerId], references: [id])
  validator       User?            @relation("ValidateOrders", fields: [validatedBy], references: [id])
  exceptions      OrderException[]
  payment         Payment?
  approvalRequest ParcelApproval?
  orderTracking   OrderTracking[]
  batch           BatchDispatch?   @relation("BatchOrders", fields: [batchId], references: [id])
  orderScans      OrderScan[]      @relation("OrderToOrderScan")

  pickupAddress   Address? @relation("PickupAddress", fields: [pickupAddressId], references: [id])
  deliveryAddress Address? @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id])

pickupDriver    User?  @relation("PickupDriverOrders", fields: [pickupDriverId], references: [id])
deliveryDriver  User?  @relation("DeliveryDriverOrders", fields: [deliveryDriverId], references: [id])

  optimizationJob OptimizationJob?      @relation("OptimizationJobOrders", fields: [optimizationJobId], references: [id])
 // driver          User?                 @relation("DriverOrders", fields: [driverId], references: [id], map: "Order_driver_fk_user")
  //orderDriver     Driver?               @relation("DriverAssignedOrders", fields: [driverId], references: [id], map: "Order_driver_fk_driver")
  priceLogs       PriceCalculationLog[]

  @@index([pickupAddressId, deliveryAddressId], name: "idx_order_addresses") // compound index for route optimization
  @@index([branchId, status], name: "idx_branch_status") // filter orders by branch + status
  @@index([customerId])
  @@index([branchId])
  @@index([pickupDriverId])
  @@index([deliveryDriverId])
  @@index([status])
  @@index([serviceType])
  @@index([fulfillmentType])
  @@index([isFragile])
  @@index([shipmentType])
  @@index([shippingScope])
  @@index([pickupAddressId])
  @@index([deliveryAddressId])
  @@index([validatedBy])
  @@index([batchId])
  @@index([tariffId])
  @@index([optimizationJobId])
}

model ParcelApproval {
  id         String         @id @default(cuid())
  orderId    String         @unique
  status     ApprovalStatus @default(PENDING)
  reason     String?
  decisionBy String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  staff User? @relation("StaffApprovals", fields: [decisionBy], references: [id])

  @@index([decisionBy])
}

model OrderTracking {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  location  String?
  updatedBy String?
  notes     String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([updatedBy])
}

model OrderException {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  reason    String
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
}

model BatchDispatch {
  id           String         @id @default(cuid())
  batchCode    String         @unique
  scope        ShippingScope // IN_TOWN, REGIONAL, INTERNATIONAL
  serviceType  ServiceType // SAME_DAY, EXPRESS, etc.
  category     String? // e.g., Electronics, Documents, Mixed
  isFragile    Boolean        @default(false)
  status       DispatchStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  createdById  String?
  notes        String?
  weight       Float?
  shipmentDate DateTime?      @db.Date

  // Relations
  originId      String?
  destinationId String?
  origin        Address?       @relation("BatchOrigin", fields: [originId], references: [id], onDelete: SetNull)
  destination   Address?       @relation("BatchDestination", fields: [destinationId], references: [id], onDelete: SetNull)
  orders           Order[]           @relation("BatchOrders")
  createdBy        User?             @relation("CreatedBatches", fields: [createdById], references: [id])
  driverId         String?
  driver           User?             @relation("BatchDispatchDriver", fields: [driverId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?          @relation("BatchDispatchVehicle", fields: [vehicleId], references: [id])
  awbNumber        String? // for international shipments
  officerId        String?
  officer          User?             @relation("BatchDispatchOfficer", fields: [officerId], references: [id])
  handovers        BatchHandover[]   @relation("HandoverBatches")
  optimizationJobs OptimizationJob[] // one batch can have multiple optimization jobs
}

model BatchHandover {
  id         String   @id @default(cuid())
  handedById String // cargo officer
  handedAt   DateTime @default(now())
  method     String? // e.g., "handed to airport", "receipt scanned"
  reference  String? // optional: receipt number or photo URL
  notes      String?

  // Relations
  batches BatchDispatch[] @relation("HandoverBatches")
  officer User            @relation("HandoverBatchesOfficer", fields: [handedById], references: [id])
}

model OrderScan {
  id        String   @id @default(cuid())
  orderId   String
  scannedBy String // officerId
  scannedAt DateTime @default(now())
  batchId   String? // optional
  notes     String? // optional notes
  valid     Boolean  @default(true)

  order Order @relation("OrderToOrderScan", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([batchId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Float
  transactionId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  order         Order         @relation(fields: [orderId], references: [id])
}

model Pricing {
  id            String         @id @default(cuid())
  baseRate      Float
  zoneFrom      String
  zoneTo        String
  serviceType   ServiceType
  shippingScope ShippingScope?

  surcharge   Float?
  corporateId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// ─────────────────── Pricing & Tariff Management ────────────────────────────────

model Tariff {
  id                 String            @id @default(cuid())
  name               String // e.g., "Express Tariff"
  serviceType        ServiceType
  baseFee            Float             @default(0) // Minimum starting fee
  perKmRate          Float             @default(0) // Cost per kilometer
  perKgRate          Float             @default(0) // Cost per kilogram
  currency           String            @default("ETB")
  isActive           Boolean           @default(true)
  effectiveFrom      DateTime          @default(now())
  effectiveTo        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  shippingScope      ShippingScope?
  customerCategoryId String?
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])

  // Relations
  orders        Order[]
  surcharges    Surcharge[]
  discounts     DiscountRule[]
  miscFees      MiscFee[]
  airportFees   AirportFee[]
  profitMargins ProfitMargin[]
}

model ProfitMargin {
  id       String @id @default(cuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  serviceType   ServiceType?
  shippingScope ShippingScope?

  percentage Float // e.g. 10% of tariff cost
  minAmount  Float? // enforce minimum margin
  maxAmount  Float? // optional cap on margin
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AirportFee {
  id       String @id @default(cuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  serviceType   ServiceType?
  shippingScope ShippingScope?

  airportCode   String // e.g., "ADD", "DXB"
  perKgRate     Float? // Cost per kilogram
  flatFee       Float? // Flat airport charge
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model MiscFee {
  id       String @id @default(cuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  serviceType   ServiceType?
  shippingScope ShippingScope?

  name         String // e.g. "Fragile Handling"
  description  String?
  feeType      FeeType? // PERCENTAGE, FLAT, PER_KG
  amount       Float
  currency     String? // e.g., "ETB", "USD"
  isPercentage Boolean  @default(false) // true = percentage of base tariff

  // New dynamic conditions
  condition Json? // e.g., { "isFragile": true, "category": "ELECTRONICS" }

  effectiveFrom DateTime? @default(now())
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Surcharge {
  id       String @id @default(cuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  serviceType   ServiceType?
  shippingScope ShippingScope?
  name          String // e.g., "Fuel Surcharge"
  type          String // "percentage" or "fixed"
  value         Float
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model DiscountRule {
  id       String @id @default(cuid())
  tariffId String
  tariff   Tariff @relation(fields: [tariffId], references: [id], onDelete: Cascade)

  shippingScope ShippingScope?
  serviceType   ServiceType?
  name          String
  type          String // "percentage" or "fixed"
  value         Float
  validFrom     DateTime
  validTo       DateTime?
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  customerCategoryId String?
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
}

model CustomerCategory {
  id          String   @id @default(cuid())
  name        String // e.g., "Individual", "Corporate", "VIP"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  tariffs       Tariff[]
  pricingRules  PricingRule[]
  discountRules DiscountRule[]
}

model PricingRule {
  id                 String            @id @default(cuid())
  shippingScope      ShippingScope
  customerCategoryId String?
  customerCategory   CustomerCategory? @relation(fields: [customerCategoryId], references: [id])
  adjustmentType     String // PERCENTAGE, FIXED
  adjustmentValue    Float
  validFrom          DateTime
  validTo            DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model PriceCalculationLog {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  weight      Float
  distance    Float?
  baseRate    Float
  appliedRate Float
  surcharges  Json // applied surcharges
  discounts   Json // applied discounts
  miscFees    Json // applied misc fees
  profit      Json // profit margin applied
  airportFee  Json? // applied airport fee if any
  finalPrice  Float
  currency    String   @default("ETB")
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Bookmark {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  description String?
  link        String?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Bookmark2 {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  title       String
  description String?
  link        String?
  userId      Int
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime @default(dbgenerated("(now() + '7 days'::interval)"))
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        String   @id @default(cuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Mfa {
  id        String   @id @default(cuid())
  userId    String   @unique
  secret    String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// ────────────────────────────── Route & Driver Enhancements ──────────────────────────────

model Location {
  id        String   @id @default(cuid())
  name      String?
  address   String?
  latitude  Float
  longitude Float
  city      String?
  country   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  originRoutes      Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")

  @@index([latitude])
  @@index([longitude])
@@unique([latitude, longitude], name: "latitude_longitude")
}

model Route {
  id            String   @id @default(cuid())
  originId      String
  destinationId String
  distanceKm    Float?
  durationMin   Float?
  routePath     Json?
  optimized     Boolean  @default(false)
  trafficAware  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  origin      Location @relation("RouteOrigin", fields: [originId], references: [id])
  destination Location @relation("RouteDestination", fields: [destinationId], references: [id])

  // Relations
  optimizationJobs  OptimizationJob[]  @relation("RouteOptimizations")
  trafficConditions TrafficCondition[]

  @@index([originId])
  @@index([destinationId])
  @@index([originId, destinationId])
}

model OptimizationJob {
  id             String             @id @default(cuid())
  jobCode        String             @unique
  type           OptimizationType
  status         OptimizationStatus @default(PENDING)
  totalDistance  Float?
  totalDuration  Float?
  createdAt      DateTime           @default(now())
  completedAt    DateTime?
  optimizedOrder Json?

  // Relations
  orders            Order[]            @relation("OptimizationJobOrders")
  batchId           String?
  batch             BatchDispatch?     @relation(fields: [batchId], references: [id])
  routes            Route[]            @relation("RouteOptimizations")
  driverId          String?
  driver            Driver?            @relation(fields: [driverId], references: [id])
  trafficConditions TrafficCondition[]
}

model Driver {
  id         String       @id @default(cuid())
  userId     String       @unique
  vehicleId  String?
  status     DriverStatus @default(OFFLINE)
  type       DriverType   @default(INTERNAL)
  currentLat Float?
  currentLon Float?
  updatedAt  DateTime?

  // Relations
  user             User?               @relation(fields: [userId], references: [id])
  vehicles         Vehicle[]           @relation("VehicleDriver")
  logs             DriverLocationLog[]
  optimizationJobs OptimizationJob[]

  @@index([userId])
  @@index([vehicleId])
  @@index([status])
  @@index([type])
}

model DriverLocationLog {
  id        String   @id @default(cuid())
  driverId  String
  latitude  Float
  longitude Float
  speed     Float?
  heading   Float?
  timestamp DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([timestamp])
}

model TrafficCondition {
  id                String          @id @default(cuid())
  routeId           String?
  optimizationJobId String?
  roadName          String
  congestionLevel   CongestionLevel
  updatedAt         DateTime        @default(now())
  lastCheckedAt     DateTime?

  // Relations
  route           Route?           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  optimizationJob OptimizationJob? @relation(fields: [optimizationJobId], references: [id], onDelete: Cascade)
}

enum DriverStatus {
  OFFLINE
  ONLINE
  AVAILABLE
  BUSY
  INTAKE
  ENROUTE
  BREAK
}

enum DriverType {
  INTERNAL
  EXTERNAL
}

enum AddressPurpose {
  USER_HOME
  USER_WORK
  ORDER_PICKUP
  ORDER_DELIVERY
  BRANCH_LOCATION
}

enum CongestionLevel {
  FREE
  LIGHT
  MEDIUM
  HEAVY
}

enum OptimizationType {
  SINGLE_ROUTE
  MULTI_STOP
}

enum OptimizationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum FeeType {
  PERCENTAGE // e.g., 5% of base price
  FLAT // fixed amount (e.g., 100 ETB per order)
  PER_KG // amount applied per kilogram
  PER_KM // amount applied per kilometer
}

enum OrderStatus {
  CREATED
  COLLECTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  VALIDATED
  SUCCESS

  ASSIGNED
  READY_FOR_PICKUP
  PICKUP_ATTEMPTED
  PICKED_UP

  IN_TRANSIT
  OUT_FOR_DELIVERY
  DROPOFF_ATTEMPTED
  DROPPED_OFF

  DISPATCHED
  PENDING
